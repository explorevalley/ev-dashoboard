# ─── Required ────────────────────────────────────────────────────────────────
# The Supabase project the dashboard reads and writes.
SUPABASE_URL=https://your-project.supabase.co
# Service-role key, NOT the anon key. The dashboard writes to tables that are
# closed to anonymous callers; with the anon key deletes silently affect
# nothing. Treat this like a root password - anyone holding it owns the data.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Signs the admin session cookie. Any long random string; changing it logs
# everyone out. Generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# The email stamped on admin sessions and shown in the dashboard header.
ADMIN_ALLOWED_EMAIL=admin@example.com

# ─── Sign-in ─────────────────────────────────────────────────────────────────
# Fallback dashboard login, used when no matching row exists in
# ev_dashboard_credentials. Set both, or leave them out and manage accounts in
# that table instead.
DASHBOARD_DEFAULT_USERNAME=
DASHBOARD_DEFAULT_PASSWORD=

# ─── Where the dashboards are served ─────────────────────────────────────────
# Defaults are readable so you can find them. If you put this on the public
# internet, set ADMIN_UI_PATH to something long and unguessable - the paths are
# the only thing standing in front of the login page.
PORT=8090
HOST=0.0.0.0
ADMIN_UI_PATH=/admin
# The four scoped dashboards default to <ADMIN_UI_PATH>/travel, /food, /support
# and /mart-vendor. Override individually if you need to.
# TRAVEL_UI_PATH=
# FOOD_UI_PATH=
# SUPPORT_UI_PATH=
# MART_VENDOR_UI_PATH=

# ─── Optional ────────────────────────────────────────────────────────────────
# Image uploads. Without these the upload buttons return a clear error and
# everything else keeps working.
SUPABASE_STORAGE_BUCKET=
# The AI form assistant. Without a key those panels stay inert.
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
