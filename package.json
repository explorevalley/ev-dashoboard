{
    "name":  "ev-admin",
    "version":  "1.0.0",
    "private":  true,
    "description":  "ExploreValley admin dashboard, standalone. Serves the UI and the API it calls, straight against Supabase.",
    "main":  "dist/server.js",
    "scripts":  {
                    "start":  "node dist/server.js",
                    "build":  "npm run build:ui \u0026\u0026 npm run build:server",
                    "build:server":  "esbuild src/server/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.js --alias:@explorevalley/shared=./vendor/shared/src/index.ts --packages=external",
                    "build:ui":  "node scripts/build-ui.cjs",
                    "env:encode":  "node scripts/env-llo.cjs encode",
                    "env:decode":  "node scripts/env-llo.cjs decode",
                    "env:check":  "node scripts/env-llo.cjs check"
                },
    "dependencies":  {
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.19.2",
                         "fs-extra":  "^11.2.0",
                         "jsonwebtoken":  "^9.0.3",
                         "multer":  "^1.4.5-lts.1",
                         "openai":  "^6.21.0",
                         "pdfkit":  "^0.15.0",
                         "proper-lockfile":  "^4.1.2",
                         "sharp":  "^0.33.5",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "esbuild":  "^0.21.0",
                            "react":  "^18.2.0",
                            "react-dom":  "^18.2.0",
                            "react-icons":  "^5.5.0"
                        },
    "engines":  {
                    "node":  "\u003e=18"
                }
}
